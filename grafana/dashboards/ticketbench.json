{
  "uid": "ticketbench",
  "title": "ticketbench",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "db",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(tb_store_scenario_duration_milliseconds_count, db_system)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Scenario p95 server time by engine",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, db_system) (rate(tb_store_scenario_duration_milliseconds_bucket[1m])))",
          "legendFormat": "{{db_system}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Scenario p95 by scenario ($db)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tb_scenario) (rate(tb_store_scenario_duration_milliseconds_bucket{db_system=~\"$db\"}[1m])))",
          "legendFormat": "{{tb_scenario}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scenario executions per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_system) (rate(tb_store_scenario_duration_milliseconds_count[1m]))",
          "legendFormat": "{{db_system}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Contention: booking attempt p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, db_system, tb_strategy, tb_clients) (rate(tb_store_contention_attempt_milliseconds_bucket[1m])))",
          "legendFormat": "{{db_system}} {{tb_strategy}} {{tb_clients}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Contention: lost seats per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_system, tb_strategy) (rate(tb_store_contention_conflicts_total[1m]))",
          "legendFormat": "{{db_system}} {{tb_strategy}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Contention: attempts per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_system, tb_strategy) (rate(tb_store_contention_attempt_milliseconds_count[1m]))",
          "legendFormat": "{{db_system}} {{tb_strategy}}"
        }
      ]
    }
  ]
}